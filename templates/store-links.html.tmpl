<!--
  公開手順:
  1. App Store URLは正式公開URLへ置換済み。{{GOOGLE_PLAY_URL}}を正式URLに置換する。
  2. App StoreはApple公式Marketing Toolsの日本語バッジを使用済み。
     Google Play公開時は公式バッジをassets/images/store/へ保存し、{{GOOGLE_PLAY_BADGE_IMAGE_PATH}}を置換する。
  3. URL、画像、表示を検証してから、この section を公開ページの main 内へコピーする。
-->
<section class="section" aria-labelledby="official-store-links-title">
  <h2 id="official-store-links-title">公式ストア</h2>
  <div class="content-grid">
    <article>
      <h3>App Store</h3>
      <p class="store-badge-row">
        <a href="https://apps.apple.com/jp/app/fa-labo-plc-console/id6783619471" aria-label="App StoreからFA Labo PLC Consoleをダウンロード">
          <img class="store-badge" src="https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/ja-jp?size=250x83" alt="App Storeからダウンロード" loading="lazy">
        </a>
      </p>
    </article>
    <article>
      <h3>Google Play</h3>
      <p>
        <a href="{{GOOGLE_PLAY_URL}}">
          <img class="store-badge" src="{{GOOGLE_PLAY_BADGE_IMAGE_PATH}}" alt="Google Play で手に入れよう" loading="lazy">
        </a>
      </p>
    </article>
  </div>
</section>
